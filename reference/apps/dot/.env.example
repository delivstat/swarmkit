# DOT — owner-only reference app. Copy to .env and fill in.
# See design/details/dot-app.md §Auth model and §Runtime integration.

# --- DOT's own session (owner ↔ DOT) ---
# Owner username (any string; used only for the login form + audit).
DOT_OWNER_USERNAME=owner

# scrypt hash of the owner password. Produce with:
#   printf '%s' 'your password' | node scripts/hash-password.mjs
DOT_OWNER_PASSWORD_HASH=

# 32+ character random string used to sign the session cookie. Rotating this
# invalidates every existing session — same discipline as the fleet panel's
# SWARMKIT_CONTROL_PLANE_SECRET_KEY. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Runtime (DOT ↔ SwarmKit runtime) ---
# Where the runtime lives; DOT proxies MCP invocations + workspace-config reads through it.
SWARMKIT_RUNTIME_URL=http://localhost:8000

# Owner-scoped bearer token. Wires later commits (see design §Auth model surface 2).
SWARMKIT_RUNTIME_TOKEN=
