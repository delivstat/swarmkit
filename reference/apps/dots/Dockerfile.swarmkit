# swarmkit serve image for the dots compose. Built from local monorepo source via uv so this
# can ship ahead of PyPI (the AG-UI protocol surface in #1020 is post-1.261.0; a plain
# `pip install swarmkit-runtime[ui]==1.261.0` does not include it yet).
#
# After v1.262.0 is cut, this Dockerfile should be replaced with the one-liner
# `RUN pip install --no-cache-dir uv && uv pip install --system "swarmkit-runtime[ui]==1.262.0"`.
#
# Build context must be the repo root (see docker-compose.yml → services.swarmkit.build.context).

FROM python:3.11-slim AS builder

RUN pip install --no-cache-dir uv

WORKDIR /app
COPY packages/runtime/ packages/runtime/
COPY packages/schema/ packages/schema/
# `[ui]` extra depends on swarmkit-webui, a workspace package.
COPY packages/webui/ packages/webui/
COPY pyproject.toml uv.lock ./

RUN uv sync --package swarmkit-runtime --extra ui --no-dev --frozen

FROM python:3.11-slim

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/packages /app/packages
# llms-full.txt is what the Author's search-swarmkit-docs tool reads from. Ship it inside
# the image at a known path; AUTHOR_LLMS_FULL_PATH defaults to /app/llms-full.txt in the
# compose env.
COPY llms-full.txt /app/llms-full.txt

ENV PATH="/app/.venv/bin:$PATH"
WORKDIR /app

EXPOSE 8000

ENTRYPOINT ["swarmkit"]
CMD ["serve", "/workspace", "--host", "0.0.0.0", "--port", "8000"]
